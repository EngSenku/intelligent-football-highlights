# API Configuration
# Base URL for the backend API (used by frontend)
# For local development, use http://127.0.0.1:8000 or http://localhost:8000
API_BASE_URL=http://127.0.0.1:8000

# CORS Configuration (comma-separated list of origins)
# For production, replace with your actual domain(s)
# Leave empty to allow all origins (not recommended for production)
CORS_ORIGINS=*

# Processing Configuration
# Maximum number of workers for background processing (default: 1)
# Increasing may speed up processing but uses more CPU/RAM
MAX_WORKERS=1

# Storage Paths (optional - uses defaults if not specified)
# DATA_DIR=/path/to/data
# UPLOAD_DIR=/path/to/uploads
# TEMP_DIR=/path/to/temp
# OUTPUT_DIR=/path/to/outputs

# Video Processing
# Frame sampling FPS (1.0-3.0 recommended; lower = faster, higher = more accurate)
FRAME_SAMPLE_FPS=2.0

# Detection Sensitivity
# Peak detection percentile (50-95). Higher = fewer, more confident events
PEAK_PERCENTILE=75.0
PEAK_STD_FACTOR=0.70

# Clip Durations (seconds)
CLIP_PRE_SECONDS=35
CLIP_POST_SECONDS=35
MIN_CLIP_DURATION_SECONDS=20
MAX_CLIP_DURATION_SECONDS=130
